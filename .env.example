# ---------------------------------------------------------------
# Armoire — environment variables
# Copy this file to .env.local and fill in the values.
# ---------------------------------------------------------------

# Google OAuth 2.0 (Web application credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Email OTP (Resend API)
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sender/domain in Resend (use onboarding@resend.dev for quick testing to your own Resend account email)
OTP_FROM_EMAIL=
OTP_FROM_NAME=Armoire

# App URL (used to build OAuth redirect URIs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign session cookies (any long random string)
SESSION_SECRET=change-this-to-a-long-random-string

# Comma-separated emails to grant Atelier access without payment (matched to signed-in account email)
ATELIER_EMAILS=

# Google Gemini API (image analysis: category, color, cleanup prompts)
GEMINI_API_KEY=

# Vercel Blob storage (recommended for Vercel deployments; enables large backend image storage)
# Create a Blob store in Vercel and set this token locally/in Vercel project settings
BLOB_READ_WRITE_TOKEN=
